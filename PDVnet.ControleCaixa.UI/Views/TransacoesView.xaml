<UserControl
    x:Class="PDVnet.ControleCaixa.UI.Views.TransacoesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#A9ABAD">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>





        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10,10,10,298">
            <Border
                Background="#064E3B"
                BorderBrush="{x:Null}"
                BorderThickness="0"
                CornerRadius="10" />

            <TextBox
                Width="129"
                Margin="36,71,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                FontSize="15"
                Foreground="#7AB89F"
                Text="Registrar Atividade"
                TextChanged="TextBox_TextChanged" />
            <Label
                Margin="31,89,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="Gestão de Fluxo"
                FontSize="25"
                Foreground="#7AB89F" />


        </Grid>

        <Grid
            Grid.ColumnSpan="2"
            Margin="10,170,10,10"
            Background="white">
            <Button
                Width="100"
                Margin="72,35,608,201"
                Content="Entrada"
                IsEnabled="False" />
            <Button
                Width="100"
                Margin="177,35,503,201"
                Content="Saida"
                IsEnabled="False" />



        </Grid>




    </Grid>
</UserControl>
