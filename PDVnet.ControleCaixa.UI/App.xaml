<Application
    x:Class="PDVnet.ControleCaixa.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PDVnet.ControleCaixa.UI.Converters"
    xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI"
    xmlns:views="clr-namespace:PDVnet.ControleCaixa.UI.Views"
    xmlns:vm="clr-namespace:PDVnet.ControleCaixa.UI.ViewModels"
    Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>

            <converters:IntToBooleanConverter x:Key="IntToBoolConverter" />
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
            <converters:DashboardConverters x:Key="DashboardConverters" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <DataTemplate DataType="{x:Type vm:DashBoardViewModel}">
                <views:DashView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FluxoDeCaixaViewModel}">
                <views:FluxoDeCaixaView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TransacoesViewModel}">
                <views:TransacoesView />
            </DataTemplate>



            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/TransacoesStyle.xaml" />
                <ResourceDictionary Source="/Themes/DashboardStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>


    </Application.Resources>
</Application>
