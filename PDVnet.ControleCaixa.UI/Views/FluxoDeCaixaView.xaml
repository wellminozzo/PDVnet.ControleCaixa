<UserControl
    x:Class="PDVnet.ControleCaixa.UI.Views.FluxoDeCaixaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="650"
    d:DesignWidth="800"
    Background="#F5F7FA"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="HeaderPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B4F3C" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Margin" Value="24,16,24,0" />
        </Style>

        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="24,16,24,24" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TextBoxBaseStyle" TargetType="Control">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style
            x:Key="CustomTextBox"
            BasedOn="{StaticResource TextBoxBaseStyle}"
            TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CustomComboBox"
            BasedOn="{StaticResource TextBoxBaseStyle}"
            TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CustomDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#A7F3D0" />
                    <Setter Property="Foreground" Value="#0B4F3C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="130" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="170" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#0B4F3C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                                    Fill="White"
                                    Stretch="Uniform" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0A3D2E" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border Style="{StaticResource HeaderPanelStyle}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#6EE7B7"
                    Text="REGISTRAR ATIVIDADE" />
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Gestão de Fluxo" />
            </StackPanel>
        </Border>

        <!--  Form Card  -->
        <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Linha 1: Tipo e Valor  -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Tipo de Lançamento" />
                        <UniformGrid Height="40" Columns="2">
                            <ToggleButton
                                Content="Entrada"
                                IsChecked="True"
                                Style="{StaticResource ToggleButtonStyle}" />
                            <ToggleButton
                                Margin="-4,0,0,0"
                                Content="Saída"
                                Style="{StaticResource ToggleButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Valor" />
                        <TextBox Style="{StaticResource CustomTextBox}" Text="R$ 0,00" />
                    </StackPanel>
                </Grid>

                <!--  Linha 2: Data e Categoria  -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Data do Lançamento" />
                        <DatePicker
                            SelectedDate="2026-07-23"
                            SelectedDateFormat="Short"
                            Style="{StaticResource CustomDatePicker}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Categoria" />
                        <ComboBox Style="{StaticResource CustomComboBox}">
                            <ComboBoxItem
                                Content="Selecione uma categoria"
                                IsEnabled="False"
                                IsSelected="True" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!--  Linha 3: Descrição  -->
                <StackPanel Grid.Row="2" Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Descrição / Observações" />
                    <TextBox
                        Height="100"
                        Padding="12,10"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Foreground="#94A3B8"
                        Style="{StaticResource CustomTextBox}"
                        Text="Adicione detalhes sobre este lançamento..."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Linha 4: Botões  -->
                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,12,0"
                        Content="Cancelar"
                        Style="{StaticResource CancelButton}" />
                    <Button Content="Salvar Lançamento" Style="{StaticResource SaveButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

