<UserControl
    x:Class="PDVnet.ControleCaixa.UI.Views.FluxoDeCaixaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="650"
    d:DesignWidth="800"
    Background="#F5F7FA"
    mc:Ignorable="d">

    <!-- Lista de Movimentações -->
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Totalizadores -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="Auto"/>
            <!-- Formulário -->
            <RowDefinition Height="*"/>
            <!-- Lista -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Style="{StaticResource HeaderPanelStyle}">
            <StackPanel>
                <TextBlock Text="ATIVIDADES"
                    FontSize="11" FontWeight="SemiBold"
                    Foreground="#6EE7B7" Margin="0,0,0,4"/>
                <TextBlock Text="Fluxo de Caixa"
                    FontSize="24" FontWeight="Bold"
                    Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- TOTALIZADORES -->
        <Grid Grid.Row="1" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Entradas" Foreground="#2E7D32" FontSize="12"/>
                    <TextBlock Text="{Binding TotalEntradas, StringFormat=C}" 
                             FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFEBEE" CornerRadius="8" Padding="15" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="Total Saídas" Foreground="#C62828" FontSize="12"/>
                    <TextBlock Text="{Binding TotalSaidas, StringFormat=C}" 
                             FontSize="20" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Saldo" Foreground="#1565C0" FontSize="12"/>
                    <TextBlock Text="{Binding Saldo, StringFormat=C}" 
                             FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILTROS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,10">
            <TextBox Width="200" 
                     Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar..."/>

            <ComboBox Width="120" Margin="10,0" 
                      SelectedItem="{Binding FiltroTipo}">
                <ComboBoxItem Content="Todos" Tag="{x:Null}"/>
                <ComboBoxItem Content="Entradas" Tag="0"/>
                <ComboBoxItem Content="Saídas" Tag="1"/>
            </ComboBox>

            <Button Content="Limpar Filtros" Command="{Binding LimparFiltroCommand}"/>
        </StackPanel>

        <!-- FORMULÁRIO (resumido) -->
        <Border Grid.Row="3" Margin="20" Padding="15" Background="White" CornerRadius="8">
            <!-- ... campos do formulário ... -->
        </Border>

        <!-- LISTA -->
        <Border Grid.Row="4" Margin="20,0,20,20" Background="White" CornerRadius="8">
            <ListView ItemsSource="{Binding MovimentacoesFiltradas}"
                      SelectedItem="{Binding MovimentacaoSelecionada}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                        <GridViewColumn Header="Data/Hora" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataMovimento, StringFormat=dd/MM/yyyy HH:mm}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tipo" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Tipo}" 
                                              Foreground="{Binding Tipo}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Categoria" DisplayMemberBinding="{Binding Categoria}" Width="120"/>
                        <GridViewColumn Header="Descrição" DisplayMemberBinding="{Binding Descricao}" Width="200"/>
                        <GridViewColumn Header="Valor" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Valor, StringFormat=C}" 
                                               FontWeight="Bold"
                                               Foreground="{Binding Tipo}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" 
                                            Command="{Binding DataContext.ExcluirCommand, 
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>

