<UserControl
    x:Class="PDVnet.ControleCaixa.UI.Views.DashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{StaticResource BackgroundBrush}"
    mc:Ignorable="d">


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ========== TOP CARDS ==========  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Saldo Total  -->
                <Border Margin="0,0,12,0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CardLabelStyle}"
                            Text="SALDO TOTAL" />
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource IconContainerStyle}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="&#xE8C9;" />
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,4"
                            Style="{StaticResource ValueLargeStyle}"
                            Text="{Binding SaldoTotal, StringFormat='R$ {0:N2}'}" />

                        <StackPanel
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="&#xE70E;" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="{Binding SaldoVariacao, StringFormat='{}{0:F1}%'}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text=" vs last month" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Entradas Hoje  -->
                <Border
                    Grid.Column="1"
                    Margin="6,0,6,0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CardLabelStyle}"
                            Text="ENTRADAS HOJE" />
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource IconContainerStyle}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="&#xE74B;" />
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,4"
                            Style="{StaticResource ValuePositiveStyle}"
                            Text="{Binding EntradasHoje, StringFormat='R$ {0:N2}'}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding EntradasTransacoes, StringFormat='{}{0} new transactions'}" />
                    </Grid>
                </Border>

                <!--  Saídas Hoje  -->
                <Border
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CardLabelStyle}"
                            Text="SAÍDAS HOJE" />
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource IconContainerStyle}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource DangerBrush}"
                                Text="&#xE74A;" />
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,4"
                            Style="{StaticResource ValueNegativeStyle}"
                            Text="{Binding SaidasHoje, StringFormat='R$ {0:N2}'}" />

                        <StackPanel
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{StaticResource DangerBrush}"
                                Text="&#xE70D;" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DangerBrush}"
                                Text="{Binding SaidasPercentualLimite, StringFormat='{}{0}%'}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text=" above daily limit" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  ========== BOTTOM SECTION ==========  -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Gráfico  -->
                <Border Margin="0,0,12,0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Fluxo de Caixa Semanal" />
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Trend analysis for the current week" />
                            </StackPanel>
                            <Border
                                Padding="10,4"
                                HorizontalAlignment="Right"
                                Background="#FFF3F4F6"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Last 7 Days" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="8"
                                        Text="&#xE70D;" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Tooltip flutuante (posicionado sobre o gráfico)  -->
                        <Border
                            Grid.Row="2"
                            Margin="0,10,40,0"
                            Padding="10,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#FF1F2937"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding GraficoTooltip, FallbackValue='Today: R$ 12,8k'}" />
                        </Border>

                        <!--  Barras  -->
                        <ItemsControl
                            Grid.Row="2"
                            Margin="0,40,0,0"
                            VerticalAlignment="Bottom"
                            ItemsSource="{Binding DadosSemanais}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="60" Margin="8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Rectangle
                                            Grid.Row="0"
                                            Height="{Binding Valor, Converter={StaticResource ChartHeightConverter}}"
                                            VerticalAlignment="Bottom"
                                            Style="{Binding IsToday, Converter={StaticResource BarStyleConverter}}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding Dia}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!--  Movimentações  -->
                <Border
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Movimentações" />
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Recentes" />
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="See All" />
                        </Grid>

                        <!--  Lista  -->
                        <ListBox
                            Grid.Row="1"
                            ItemsSource="{Binding UltimasMovimentacoes}"
                            Style="{StaticResource TransactionListStyle}">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{Binding Descricao}" />

                                            <TextBlock FontSize="11" Text="{Binding Categoria}" />

                                            <TextBlock FontSize="10" Text="{Binding DataMovimento, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding Valor, StringFormat='R$ {0:N2}'}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
