<UserControl
    x:Class="PDVnet.ControleCaixa.UI.Views.DashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="{StaticResource BackgroundBrush}"
    mc:Ignorable="d">

    

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="1" >
        
        
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource HeaderPanelStyle}">
                <StackPanel>
                    <TextBlock Text="ATIVIDADES"
                    FontSize="11" FontWeight="SemiBold"
                    Foreground="#6EE7B7" Margin="0,0,0,4"/>
                    <TextBlock Text="DashBoard"
                    FontSize="24" FontWeight="Bold"
                    Foreground="White"/>
                </StackPanel>
            </Border>
            <!--  ========== TOP CARDS ==========  -->
            
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                

                <!--  SALDO TOTAL  -->
               

                <!--  ENTRADAS HOJE  -->
                <Border
                    Grid.Column="0"
                    Margin="24,20,0,0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource CardLabelStyle}" Text="ENTRADAS HOJE" />

                        <Border Grid.Column="1"  Style="{StaticResource IconContainerStyle}">
                            <TextBlock
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="&#xE74B;" />
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,8"
                            Style="{StaticResource ValuePositiveStyle}"
                            Text="{Binding EntradasHoje, StringFormat='R$ {0:N2}'}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Entradas registradas hoje" />
                    </Grid>
                </Border>

                <!--  SAÍDAS HOJE  -->
                <Border
                    Grid.Column="1"
                    Margin="12,20,0,0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource CardLabelStyle}" Text="SAÍDAS HOJE" />

                        <Border Grid.Column="1" Style="{StaticResource IconContainerStyle}">
                            <TextBlock
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource DangerBrush}"
                                Text="&#xE74A;" />
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,8"
                            Style="{StaticResource ValueNegativeStyle}"
                            Text="{Binding SaidasHoje, StringFormat='R$ {0:N2}'}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Saídas registradas hoje" />
                    </Grid>
                </Border>
            </Grid>

            <!--  ========== BOTTOM SECTION ==========  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Gráfico  -->
                <Border Margin="24,0,1,0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Relatórios" />
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Análise Semanal" />
                            </StackPanel>
                        </Grid>

                        <!--  Total de movimentações  -->
                        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="14,12"
            Background="#FFF3F4F6"
            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="TOTAL DE MOVIMENTAÇÕES" />
                                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding TotalMovimentacoes}" />
                                </StackPanel>

                               
                            </Grid>
                        </Border>

                       
                       
                    </Grid>
                </Border>

                <!--  Movimentações  -->
                <Border
                    Grid.Column="1"
                    Margin="12,0,21,0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Movimentações" />
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Recentes" />
                            </StackPanel>
                            
                        </Grid>

                        <!--  Lista  -->
                        <ListBox
                            Grid.Row="1"
                            ItemsSource="{Binding UltimasMovimentacoes}"
                            Style="{StaticResource TransactionListStyle}">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="0,8"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Descricao}" />

                                                <TextBlock FontSize="11" Text="{Binding Categoria}" />

                                                <TextBlock FontSize="10" Text="{Binding DataMovimento, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Text="{Binding Valor, StringFormat='R$ {0:N2}'}" />
                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
